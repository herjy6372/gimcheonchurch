rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApproved() { return signedIn() && me().approved == true; }
    function isAdmin() { return signedIn() && me().admin == true; }
    function autoApproveOn() {
      return exists(/databases/$(database)/documents/settings/general)
             && get(/databases/$(database)/documents/settings/general).data.autoApprove == true;
    }
    // 게시판 쓰기 권한: 관리자·목사는 모든 게시판, 집사는 교회소식(성별무관)·남/여전도회(성별일치), 청년은 청년회
    function myRole() { return signedIn() ? me().role : null; }
    function myGender() { return signedIn() ? me().gender : null; }
    function canWriteNotice() {
      return isAdmin() || myRole() == '목사' || myRole() == '집사';
    }
    function canWritePost(board) {
      return isAdmin() || myRole() == '목사'
             || (board == 'men' && myRole() == '집사' && myGender() == 'M')
             || (board == 'women' && myRole() == '집사' && myGender() == 'F')
             || (board == 'youth' && myRole() == '청년');
    }

    // 회원 정보
    match /users/{uid} {
      // 본인 또는 관리자만 읽기
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 가입 시 본인 문서만 생성 가능. 자동승인 모드가 꺼져 있으면 approved는 반드시 false로만 생성 가능(스스로 승인 불가)
      // 직분(role)도 가입 시점에 스스로 지정할 수 없음(관리자만 나중에 부여)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.admin == false
                    && !('role' in request.resource.data)
                    && (request.resource.data.approved == false
                        || (request.resource.data.approved == true && autoApproveOn()));
      // 승인/거절/권한변경은 관리자만. 본인은 approved·admin·role 값을 바꾸지 않는 선에서 개인정보 수정 가능
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.approved == resource.data.approved
                        && request.resource.data.admin == resource.data.admin
                        && request.resource.data.role == resource.data.role);
      // 삭제(탈퇴)는 관리자 또는 본인만
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // 교회소식 (누구나 열람 가능, 쓰기는 관리자·목사·집사)
    match /notices/{id} {
      allow read: if true;
      allow create: if signedIn() && canWriteNotice()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && canWriteNotice();
    }

    // 남전도회·여전도회·청년회 게시판 (열람은 가입한 회원 누구나, 쓰기는 직분에 따라 제한)
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && canWritePost(request.resource.data.board)
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && canWritePost(resource.data.board);
    }

    // 휴대폰 번호 중복 가입 방지용 마커 (소유자 또는 관리자만 해제 가능 — 번호 변경·탈퇴·관리자 수정 시 사용)
    match /phoneNumbers/{phone} {
      // 문서 하나 존재 확인만 공개 허용. list(전체 목록 조회)는 막아서 번호 전체 유출을 방지.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // 사이트 설정 (자동승인 모드 등, 민감정보 없음)
    match /settings/{id} {
      // 문서 하나 조회만 공개 허용(회원가입 화면에서 로그인 전 확인용). list는 막음.
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
  }
}
