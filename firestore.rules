rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApproved() { return signedIn() && me().approved == true; }
    function isAdmin() { return signedIn() && me().admin == true; }

    // 회원 정보
    match /users/{uid} {
      // 본인 또는 관리자만 읽기
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 가입 시 본인 문서만 생성 가능(스스로 승인/관리자 지정 불가)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.approved == false
                    && request.resource.data.admin == false;
      // 승인/거절/수정은 관리자만
      allow update, delete: if isAdmin();
    }

    // 공지사항
    match /notices/{id} {
      allow read: if isApproved() || isAdmin();   // 승인된 회원만 열람
      allow create, update, delete: if isAdmin(); // 등록은 관리자만
    }
  }
}
