rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApproved() { return signedIn() && me().approved == true; }
    function isAdmin() { return signedIn() && me().admin == true; }

    // 회원 정보
    match /users/{uid} {
      // 본인 또는 관리자만 읽기
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 가입 시 본인 문서만 생성 가능(스스로 승인/관리자 지정 불가)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.approved == false
                    && request.resource.data.admin == false;
      // 승인/거절/수정은 관리자만
      allow update, delete: if isAdmin();
    }

    // 공지사항
    match /notices/{id} {
      allow read: if isApproved() || isAdmin();   // 승인된 회원만 열람
      allow create, update, delete: if isAdmin(); // 등록은 관리자만
    }

    // 휴대폰 번호 중복 가입 방지용 마커 (개인정보 없이 존재 여부만 저장)
    match /phoneNumbers/{phone} {
      allow read: if true;                 // 가입 전 중복 확인(번호 존재 여부만 노출)
      allow create: if signedIn();         // 이미 문서가 있으면 create 대신 update로 취급되어 아래 규칙에 막힘(중복 방지)
      allow update, delete: if false;
    }
  }
}
